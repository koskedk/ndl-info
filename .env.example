# Access settings for the DHA datalake project.
# Copy to .env and fill in. .env is git-ignored; this template is safe to commit.

# --- Source lake: external Ceph S3 (reachable only with the VPN connected) ---
# Full URL including scheme and port, e.g. https://ceph-rgw.example.go.ke:7480
SRC_S3_ENDPOINT=
SRC_S3_ACCESS_KEY=
SRC_S3_SECRET_KEY=
# Ceph ignores the region but clients require one; us-east-1 is the usual default.
SRC_S3_REGION=us-east-1
# Comma-separated bucket names you were given, e.g. bronze,staging
SRC_S3_BUCKETS=
# Ceph RGW normally needs path-style addressing (endpoint/bucket, not bucket.endpoint).
SRC_S3_PATH_STYLE=true
# Set to false only if the endpoint uses a self-signed certificate.
SRC_S3_VERIFY_SSL=true
# Optional: path to a CA bundle (.pem) if the endpoint uses a private CA.
SRC_S3_CA_BUNDLE=

# --- Source lake: Iceberg catalog (leave blank if you only have bucket access) ---
# One of: rest, hive, none
SRC_ICEBERG_CATALOG_TYPE=none
# rest: https://host:port/catalog   hive: thrift://host:9083
SRC_ICEBERG_CATALOG_URI=
# Warehouse name or s3://bucket/prefix root, as given by the catalog owner.
SRC_ICEBERG_WAREHOUSE=
# REST catalog auth, if any: a bearer token, or client-id:client-secret for OAuth2.
SRC_ICEBERG_TOKEN=
SRC_ICEBERG_CREDENTIAL=

# --- ClickHouse (UAT) ---
# Hostname or IP only, no scheme.
CH_HOST=
# 8123 = HTTP, 8443 = HTTPS, 9000 = native, 9440 = native over TLS.
CH_PORT=8123
CH_USER=
CH_PASS=
CH_DATABASE=default
# true if the server expects TLS (ports 8443 / 9440).
CH_SECURE=false
